{
  "name": "structusight",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && rm -rf build && cp -r dist build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "architecture-audit": "tsx scripts/architecture-audit.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:auth": "tsx scripts/test-authentication-regression.ts",
    "run-integration-tests": "tsx scripts/run-integration-tests.ts",
    "test:forensic": "tsx scripts/test-forensic-e2e-regression.ts",
    "generate-evidence-report": "tsx scripts/generate-evidence-report.ts",
    "verify-all": "npm run lint && npm run test && npm run test:auth && npm run test:forensic && npm run run-integration-tests && npm run generate-evidence-report && npm run architecture-audit && npm run build",
    "remediation-audit": "node scripts/engineering-remediation-audit.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "cors": "^2.8.6",
    "date-fns": "^4.2.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.2.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cache": "^5.1.2",
    "pg": "^8.21.0",
    "postcss": "^8.5.15",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.14.0",
    "@types/node-cache": "^4.1.3",
    "@types/pg": "^8.20.0",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10"
  }
}
