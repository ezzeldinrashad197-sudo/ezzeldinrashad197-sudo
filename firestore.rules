rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Globals & Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'all' || 
        getUserRole() == 'executive' || 
        getUserRole() == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isEditor() {
      return isSignedIn() && (
        isAdmin() ||
        getUserRole() == 'pd' ||
        getUserRole() == 'pm' ||
        getUserRole() == 'em' ||
        getUserRole() == 'qaqc' ||
        getUserRole() == 'dc'
      );
    }
    
    function isValidId(id) {
      return id.size() <= 128 && id.matches('^[a-zA-Z0-9_@.+-]+$');
    }

    function isAdminOrProjectMember(projectId) {
      return isSignedIn() && (
        isAdmin() ||
        (
          getUserData().projectScope is list && projectId in getUserData().projectScope
        ) ||
        (
          getUserData().projectScope is string && getUserData().projectScope == projectId
        )
      );
    }

    function isEditorForProject(projectId) {
      return isSignedIn() && isEditor() && isAdminOrProjectMember(projectId);
    }

    function hasResourceProjectAccess() {
      return isSignedIn() && resource.data.projectId is string && isAdminOrProjectMember(resource.data.projectId);
    }

    function hasRequestProjectAccess() {
      return isSignedIn() && request.resource.data.projectId is string && isAdminOrProjectMember(request.resource.data.projectId);
    }

    // Default Lockout (Enterprise Least-Privilege Baseline)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- COLLECTION: users ---
    // Protected: Users can read their own profile, or admins can read all profiles.
    // Non-admins cannot edit sensitive security fields (roles, accessLevel, accountStatus).
    match /users/{userId} {
      allow read: if isSignedIn() && (isCurrentUser(userId) || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() || (
          isCurrentUser(userId) && 
          (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'viewer')
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          isCurrentUser(userId) && 
          request.resource.data.role == resource.data.role &&
          request.resource.data.accountStatus == resource.data.accountStatus &&
          request.resource.data.accessLevel == resource.data.accessLevel
        )
      );
      allow delete: if isSignedIn() && isAdmin();
    }

    // --- COLLECTION: project_stats ---
    match /project_stats/{projectId} {
      allow read: if isAdminOrProjectMember(projectId);
      allow create, update, delete: if isEditorForProject(projectId);
    }

    // --- COLLECTION: audit_logs ---
    // Append-only audit logs. Normal users cannot modify or delete logs, and must write their own uid.
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- COLLECTION: security_test_history ---
    // Immutable security evidence. Only authorized administrators can create evidence records, update/delete is strictly prohibited.
    match /security_test_history/{historyId} {
      allow read: if isSignedIn() && (isAdmin() || isEditor());
      allow create: if isSignedIn() && isAdmin();
      allow update, delete: if false;
    }

    // --- COLLECTION: projects ---
    match /projects/{projectId} {
      allow read: if isAdminOrProjectMember(projectId);
      allow create, update, delete: if isEditorForProject(projectId);
    }

    // --- COLLECTION: analytics ---
    match /analytics/{analyticsId} {
      allow read: if hasResourceProjectAccess();
      allow create: if isEditor() && hasRequestProjectAccess();
      allow update: if isEditor() && hasResourceProjectAccess() && hasRequestProjectAccess();
      allow delete: if isEditor() && hasResourceProjectAccess();
    }

    // --- COLLECTION: settings ---
    match /settings/{settingsId} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION: reports ---
    match /reports/{reportId} {
      allow read: if hasResourceProjectAccess();
      allow create: if isEditor() && hasRequestProjectAccess();
      allow update: if isEditor() && hasResourceProjectAccess() && hasRequestProjectAccess();
      allow delete: if isEditor() && hasResourceProjectAccess();
    }
  }
}
